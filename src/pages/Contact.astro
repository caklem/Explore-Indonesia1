---
// Halaman Contact - Indonesia Travel
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact | Explore Indonesia</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/LOGO.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/LOGO.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/LOGO.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/LOGO.png?v=2" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Noto+Sans:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      @import url("/src/styles/global.css");
      @import url("/src/styles/contact.css");
    </style>
  </head>
  <body>
    <Header currentPage="contact" />

    <main class="main-content">
      <div class="contact-main">
        <h1 class="contact-title">Get In Touch</h1>
        <p class="contact-subtitle">
          Have questions about our Indonesia tour packages? We'd love to hear
          from you!
        </p>
        <div class="contact-card">
          <div class="contact-info">
            <h2>Contact Information</h2>
            <p>
              Ready to explore the beauty of Indonesia? Contact us today and let
              us help you plan your perfect adventure!
            </p>
            <div class="contact-icons">
              <div class="contact-item">
                <span class="icon whatsapp">
                  <svg width="28" height="28" viewBox="0 0 32 32" fill="none"
                    ><circle cx="16" cy="16" r="16" fill="white" opacity="0.2"
                    ></circle><path
                      d="M22.5 19.5c-.4-.2-2.3-1.1-2.6-1.2-.3-.1-.5-.2-.7.2-.2.4-.8 1.2-1 1.4-.2.2-.4.3-.8.1-.4-.2-1.7-.6-3.2-2-1.2-1.1-2-2.4-2.2-2.8-.2-.4 0-.6.2-.8.2-.2.4-.5.6-.7.2-.2.2-.4.3-.6.1-.2 0-.5-.1-.7-.1-.2-.7-1.7-.9-2.3-.2-.6-.5-.5-.7-.5-.2 0-.5 0-.7 0-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.7 0 1.6 1.2 3.1 1.4 3.3.2.2 2.3 3.5 5.6 4.7.8.3 1.4.5 1.9.6.8.1 1.5.1 2.1.1.6 0 1.8-.6 2.1-1.2.3-.6.3-1.1.2-1.2z"
                      fill="#fff"></path></svg
                  >
                </span>
                <div class="contact-details">
                  <span class="contact-label">WhatsApp</span>
                  <span class="contact-value">+62 811-3787-741</span>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon email">
                  <svg width="28" height="28" viewBox="0 0 32 32" fill="none"
                    ><circle cx="16" cy="16" r="16" fill="white" opacity="0.2"
                    ></circle><path d="M8 12v8h16v-8l-8 5-8-5z" fill="#fff"
                    ></path><path
                      d="M8 12l8 5 8-5"
                      stroke="#fff"
                      stroke-width="2"></path></svg
                  >
                </span>
                <div class="contact-details">
                  <span class="contact-label">Email</span>
                  <span class="contact-value">info@exploreindonesia.com</span>
                </div>
              </div>
              <div class="contact-item">
                <span class="icon location">
                  <svg width="28" height="28" viewBox="0 0 32 32" fill="none"
                    ><circle cx="16" cy="16" r="16" fill="white" opacity="0.2"
                    ></circle><path
                      d="M16 8a6 6 0 0 0-6 6c0 4.5 6 10 6 10s6-5.5 6-10a6 6 0 0 0-6-6zm0 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4z"
                      fill="#fff"></path></svg
                  >
                </span>
                <div class="contact-details">
                  <span class="contact-label">Office</span>
                  <span class="contact-value"
                    >Jl. Sudirman No. 123<br />Jakarta, Indonesia</span
                  >
                </div>
              </div>
            </div>
          </div>
          <form class="contact-form">
            <div class="form-row">
              <div class="form-group">
                <label for="name">Your Name *</label>
                <input
                  id="name"
                  type="text"
                  placeholder="Enter your name"
                  required
                />
              </div>
              <div class="form-group">
                <label for="email">Your Email *</label>
                <input
                  id="email"
                  type="email"
                  placeholder="Enter your email"
                  required
                />
              </div>
            </div>
            <div class="form-group">
              <label for="subject">Your Subject *</label>
              <input
                id="subject"
                type="text"
                placeholder="Enter subject"
                required
              />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" rows="5" placeholder="Type your message..."
              ></textarea>
            </div>
            <button type="submit">SEND MESSAGE</button>
          </form>
        </div>
      </div>
    </main>
    <script>
      // Fade-in animation on page load
      document.addEventListener("DOMContentLoaded", function () {
        setTimeout(() => {
          document.body.style.opacity = "1";
        }, 50);
      });

      // Fade-out animation on navigation
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".nav-menu a").forEach((item) => {
          item.addEventListener("click", function (this: HTMLAnchorElement, e) {
            const href = this.getAttribute("href");
            console.log("Clicked link:", href); // Debug
            if (href && !href.startsWith("#") && !href.startsWith("/contact")) {
              e.preventDefault();
              document.body.classList.add("fade-out");
              setTimeout(() => {
                window.location.href = href;
              }, 500);
            }
          });
        });
      });

      // Header scroll effect
      window.addEventListener("scroll", function () {
        const header = document.querySelector(".header");
        const logo = document.querySelector(".logo");
        const navLinks = document.querySelectorAll(".nav-menu a");

        if (window.scrollY > 50 && header && logo) {
          header.classList.add("scrolled");
          (header as HTMLElement).style.background =
            "rgba(255, 255, 255, 0.95)";
          (header as HTMLElement).style.backdropFilter = "blur(20px)";
          (header as HTMLElement).style.boxShadow =
            "0 2px 20px rgba(0, 0, 0, 0.1)";
          (header as HTMLElement).style.borderBottom =
            "1px solid rgba(255, 255, 255, 0.2)";

          // Change text color to dark when scrolled
          (logo as HTMLElement).style.color = "#333";
          (logo as HTMLElement).style.textShadow = "none";
          navLinks.forEach((link) => {
            if (link.classList.contains("active")) {
              (link as HTMLElement).style.color = "#ff6b6b"; // Keep active link red
            } else {
              (link as HTMLElement).style.color = "#333";
            }
            (link as HTMLElement).style.textShadow = "none";
          });
        } else if (header && logo) {
          header.classList.remove("scrolled");
          (header as HTMLElement).style.background = "transparent";
          (header as HTMLElement).style.backdropFilter = "none";
          (header as HTMLElement).style.boxShadow = "none";
          (header as HTMLElement).style.borderBottom = "none";

          // Change text color back to dark when at top
          (logo as HTMLElement).style.color = "#333";
          (logo as HTMLElement).style.textShadow = "none";
          navLinks.forEach((link) => {
            if (link.classList.contains("active")) {
              (link as HTMLElement).style.color = "#ff6b6b"; // Keep active link red
            } else {
              (link as HTMLElement).style.color = "#333";
            }
            (link as HTMLElement).style.textShadow = "none";
          });
        }
      });

      // Set active navigation based on current page
      function setActiveNavigation() {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll(".nav-menu a");
        const mobileNavLinks = document.querySelectorAll(
          ".mobile-sidebar .nav-menu a"
        );

        // Remove active class from all links
        [...navLinks, ...mobileNavLinks].forEach((link) => {
          link.classList.remove("active");
        });

        // Add active class to current page link
        [...navLinks, ...mobileNavLinks].forEach((link) => {
          const linkPath = new URL(link.href).pathname;
          if (
            currentPath === linkPath ||
            (currentPath === "/" && linkPath === "/")
          ) {
            link.classList.add("active");
          }
        });
      }

      // Call function on page load
      setActiveNavigation();

      // Mobile Menu Toggle
      document.addEventListener("DOMContentLoaded", function () {
        const hamburger = document.querySelector(".hamburger");
        const mobileSidebar = document.querySelector(".mobile-sidebar");
        const mobileOverlay = document.querySelector(".mobile-overlay");
        const navLinks = document.querySelectorAll(
          ".mobile-sidebar .nav-menu a"
        );

        if (hamburger && mobileSidebar && mobileOverlay) {
          hamburger.addEventListener("click", function (this: HTMLElement) {
            this.classList.toggle("active");
            mobileSidebar.classList.toggle("active");
            mobileOverlay.classList.toggle("active");
            document.body.style.overflow = mobileSidebar.classList.contains(
              "active"
            )
              ? "hidden"
              : "";
          });

          mobileOverlay.addEventListener("click", function (this: HTMLElement) {
            hamburger.classList.remove("active");
            mobileSidebar.classList.remove("active");
            this.classList.remove("active");
            document.body.style.overflow = "";
          });

          navLinks.forEach((link) => {
            link.addEventListener("click", function () {
              hamburger.classList.remove("active");
              mobileSidebar.classList.remove("active");
              mobileOverlay.classList.remove("active");
              document.body.style.overflow = "";
            });
          });

          // Close sidebar when pressing Escape key
          document.addEventListener("keydown", function (e) {
            if (
              e.key === "Escape" &&
              mobileSidebar.classList.contains("active")
            ) {
              hamburger.classList.remove("active");
              mobileSidebar.classList.remove("active");
              mobileOverlay.classList.remove("active");
              document.body.style.overflow = "";
            }
          });
        }
      });
    </script>

    <!-- Footer -->
    <Footer />
  </body>
</html>
