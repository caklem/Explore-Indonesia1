      // Image Slider Functions
      document.addEventListener("DOMContentLoaded", function () {
        // Initialize all sliders
        const sliders = document.querySelectorAll(".image-slider");

        sliders.forEach((slider) => {
          const images = slider.querySelectorAll(".product-image");
          const dots = slider.querySelectorAll(".slider-dot");
          const prevBtn = slider.querySelector(".slider-nav.prev");
          const nextBtn = slider.querySelector(".slider-nav.next");

          let currentIndex = 0;

          // Show initial image
          showSlide(slider, currentIndex);

          // Previous button
          prevBtn.addEventListener("click", () => {
            currentIndex =
              currentIndex > 0 ? currentIndex - 1 : images.length - 1;
            showSlide(slider, currentIndex);
          });

          // Next button
          nextBtn.addEventListener("click", () => {
            currentIndex =
              currentIndex < images.length - 1 ? currentIndex + 1 : 0;
            showSlide(slider, currentIndex);
          });

          // Dots navigation
          dots.forEach((dot, index) => {
            dot.addEventListener("click", () => {
              currentIndex = index;
              showSlide(slider, currentIndex);
            });
          });
        });

        function showSlide(slider, index) {
          const images = slider.querySelectorAll(".product-image");
          const dots = slider.querySelectorAll(".slider-dot");

          // Hide all images
          images.forEach((img) => {
            img.style.display = "none";
            img.classList.remove("active");
          });

          // Remove active from all dots
          dots.forEach((dot) => {
            dot.classList.remove("active");
          });

          // Show current image
          images[index].style.display = "block";
          images[index].classList.add("active");
          dots[index].classList.add("active");
        }

        // Modal functionality
        const modal = document.getElementById("imageModal");
        const modalImg = document.getElementById("modalImage");
        const modalClose = document.querySelector(".modal-close");
        const modalPrev = document.getElementById("modalPrev");
        const modalNext = document.getElementById("modalNext");

        let currentModal = {
          images: [],
          index: 0,
        };

        // Add click event to all product images
        document.querySelectorAll(".product-image").forEach((img, imgIndex) => {
          img.style.cursor = "pointer";
          img.addEventListener("click", () => {
            const slider = img.closest(".image-slider");
            const sliderImages = slider.querySelectorAll(".product-image");
            const productCard = slider.closest(".product-card");
            const productTitle = productCard
              ? productCard.querySelector("h3")?.textContent
              : "Indonesia Travel Package";

            // Get all image sources for this slider
            currentModal.images = Array.from(sliderImages).map((image) => {
              // Handle both 250x250 and 300x300 image sizes
              return image.src
                .replace("w=250&h=250", "w=800&h=600")
                .replace("w=300&h=300", "w=800&h=600");
            });

            currentModal.index = parseInt(img.dataset.slide);
            currentModal.title = productTitle;

            showModalImage();
            modal.classList.add("show");
            document.body.style.overflow = "hidden";
          });
        });

        function showModalImage() {
          modalImg.src = currentModal.images[currentModal.index];

          // Update image info
          const modalImageTitle = document.getElementById("modalImageTitle");
          const modalImageCounter =
            document.getElementById("modalImageCounter");

          if (modalImageTitle) {
            modalImageTitle.textContent = currentModal.title || "Image Gallery";
          }

          if (modalImageCounter) {
            modalImageCounter.textContent = `${currentModal.index + 1} / ${currentModal.images.length}`;
          }
        }

        // Modal navigation
        modalPrev.addEventListener("click", () => {
          currentModal.index =
            currentModal.index > 0
              ? currentModal.index - 1
              : currentModal.images.length - 1;
          showModalImage();
        });

        modalNext.addEventListener("click", () => {
          currentModal.index =
            currentModal.index < currentModal.images.length - 1
              ? currentModal.index + 1
              : 0;
          showModalImage();
        });

        // Close modal
        modalClose.addEventListener("click", () => {
          modal.classList.remove("show");
          document.body.style.overflow = "";
        });

        // Close modal when clicking outside
        modal.addEventListener("click", (e) => {
          if (e.target === modal) {
            modal.classList.remove("show");
            document.body.style.overflow = "";
          }
        });

        // Modal keyboard navigation
        document.addEventListener("keydown", (e) => {
          if (modal.classList.contains("show")) {
            switch (e.key) {
              case "Escape":
                modal.classList.remove("show");
                document.body.style.overflow = "";
                break;
              case "ArrowLeft":
                e.preventDefault();
                currentModal.index =
                  currentModal.index > 0
                    ? currentModal.index - 1
                    : currentModal.images.length - 1;
                showModalImage();
                break;
              case "ArrowRight":
                e.preventDefault();
                currentModal.index =
                  currentModal.index < currentModal.images.length - 1
                    ? currentModal.index + 1
                    : 0;
                showModalImage();
                break;
            }
          }
        });

        // Generalized Detail Modals functionality (supports multiple detail modals)
        // Open modals based on data-modal attribute or product name
        document.querySelectorAll(".view-details-btn").forEach((btn) => {
          btn.addEventListener("click", (e) => {
            e.preventDefault();

            // Prefer explicit data-modal attribute
            const dataModal = btn.getAttribute("data-modal");
            let modalId = "detailModal"; // default

            if (dataModal) {
              modalId =
                "detailModal" +
                dataModal.charAt(0).toUpperCase() +
                dataModal.slice(1);
            } else {
              // Fallback: detect product name
              const productCard = btn.closest(".product-card");
              const productName =
                productCard
                  ?.querySelector(".product-name")
                  ?.textContent?.toLowerCase() || "";
              if (productName.includes("zaviero")) {
                modalId = "detailModalZaviero";
              } else {
                modalId = "detailModal";
              }
            }

            const modalEl = document.getElementById(modalId);
            if (modalEl) {
              modalEl.classList.add("show");
              document.body.style.overflow = "hidden";

              // Initialize trip option colors for the active option within the opened modal
              const activeOpt = modalEl.querySelector(
                ".detail-trip-option.active"
              );
              if (activeOpt) updateDestinationColors(activeOpt);
            }
          });
        });

        // Force mapping for Rent Car to use dedicated Rentcar modal (defensive fix)
        document
          .querySelectorAll(".product-card.rent-car .view-details-btn")
          .forEach((btn) => {
            btn.addEventListener("click", function (e) {
              e.preventDefault();
              const modalEl =
                document.getElementById("detailModalRentcar") ||
                Array.from(document.querySelectorAll(".detail-modal")).find(
                  (m) => m.id && m.id.toLowerCase() === "detailmodalrentcar"
                );
              if (modalEl) {
                modalEl.classList.add("show");
                document.body.style.overflow = "hidden";
                const activeOpt = modalEl.querySelector(
                  ".detail-trip-option.active"
                );
                if (activeOpt) updateDestinationColors(activeOpt);
              } else {
                console.warn("Rent Car modal (detailModalRentcar) not found");
              }
            });
          });

        // Ensure required sections exist for every detail modal (included/excluded, contact, back button)
        (function ensureDetailModalSections() {
          const defaultModal = document.getElementById("detailModal");
          if (!defaultModal) return;

          document.querySelectorAll(".detail-modal").forEach((modal) => {
            // skip the default modal
            if (modal === defaultModal) return;

            // required selectors and where to insert them
            const required = [
              {
                sel: ".detail-included-excluded",
                insertBefore: ".detail-section",
              },
              { sel: ".detail-contact", insertBefore: ".detail-footer" },
              { sel: ".detail-back-btn", appendTo: ".detail-modal-content" },
            ];

            required.forEach((req) => {
              if (!modal.querySelector(req.sel)) {
                const source = defaultModal.querySelector(req.sel);
                if (!source) return;
                const clone = source.cloneNode(true);

                // Insert clone in a sensible place
                if (req.appendTo) {
                  const target = modal.querySelector(req.appendTo) || modal;
                  target.appendChild(clone);
                } else if (req.insertBefore) {
                  const anchor = modal.querySelector(req.insertBefore);
                  if (anchor) {
                    anchor.parentNode.insertBefore(clone, anchor);
                  } else {
                    modal
                      .querySelector(".detail-modal-body")
                      ?.appendChild(clone);
                  }
                }
              }
            });
          });
        })();

        // Close/open handlers for all detail modals
        document.querySelectorAll(".detail-modal").forEach((modal) => {
          const closeBtn = modal.querySelector(".detail-modal-close");
          if (closeBtn) {
            closeBtn.addEventListener("click", () => {
              modal.classList.remove("show");
              document.body.style.overflow = "";
            });
          }

          const backBtn = modal.querySelector(".detail-back-btn");
          if (backBtn) {
            backBtn.addEventListener("click", () => {
              modal.classList.remove("show");
              document.body.style.overflow = "";
            });
          }

          modal.addEventListener("click", (e) => {
            if (e.target === modal) {
              modal.classList.remove("show");
              document.body.style.overflow = "";
            }
          });
        });

        // Escape key closes any open detail modal
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape") {
            document.querySelectorAll(".detail-modal.show").forEach((m) => {
              m.classList.remove("show");
            });
            document.body.style.overflow = "";
          }
        });

        // Function to update destination colors (supports half-day, full-day, and full-day-sunset)
        function updateDestinationColors(selectedOption) {
          const tripType = selectedOption.getAttribute("data-trip");
          const halfDayDestinations = document.querySelectorAll(
            ".half-day-destinations .detail-dest-item"
          );
          const fullDayDestinations = document.querySelectorAll(
            ".full-day-destinations .detail-dest-item"
          );
          const sunsetDestinations = document.querySelectorAll(
            ".full-day-sunset .detail-dest-item"
          );

          const setActive = (items) => {
            items.forEach((item) => {
              item.classList.add("active-dest");
              item.classList.remove("inactive-dest");
              const icon = item.querySelector(".detail-dest-icon");
              if (icon) {
                icon.classList.add("active-icon");
                icon.classList.remove("inactive-icon");
              }
            });
          };

          const setInactive = (items) => {
            items.forEach((item) => {
              item.classList.add("inactive-dest");
              item.classList.remove("active-dest");
              const icon = item.querySelector(".detail-dest-icon");
              if (icon) {
                icon.classList.add("inactive-icon");
                icon.classList.remove("active-icon");
              }
            });
          };

          // Reset all to inactive first
          setInactive(halfDayDestinations);
          setInactive(fullDayDestinations);
          setInactive(sunsetDestinations);

          if (tripType === "half-day") {
            setActive(halfDayDestinations);
          } else if (tripType === "full-day") {
            setActive(fullDayDestinations);
          } else if (tripType === "full-day-sunset") {
            setActive(sunsetDestinations);
          }
        }

        // Detail trip options toggle
        document.querySelectorAll(".detail-trip-option").forEach((option) => {
          option.addEventListener("click", () => {
            // Remove active from all options
            document.querySelectorAll(".detail-trip-option").forEach((opt) => {
              opt.classList.remove("active");
            });
            // Add active to clicked option
            option.classList.add("active");

            // Update destination colors
            updateDestinationColors(option);
          });
        });

        // Initialize destination colors for active option
        const activeOption = document.querySelector(
          ".detail-trip-option.active"
        );
        if (activeOption) {
          updateDestinationColors(activeOption);
        }

        // Initialize rent-car trip options toggle
        initializeRentCarTripOptions();
      });

      function initializeRentCarTripOptions() {
        const rentCarCard = document.querySelector(".product-card.rent-car");
        if (rentCarCard) {
          const tripOptions = rentCarCard.querySelectorAll(
            ".product-content .trip-options .trip-option"
          );

          // Add click event listeners to trip options
          tripOptions.forEach((option) => {
            option.addEventListener("click", function () {
              // Remove active class from all options
              tripOptions.forEach((opt) => opt.classList.remove("active"));
              // Add active class to clicked option
              this.classList.add("active");
            });
          });
        }
      }
    </script>

