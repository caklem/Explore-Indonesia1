    <script>
      // Fade-in animation on page load
      document.addEventListener("DOMContentLoaded", function () {
        setTimeout(() => {
          document.body.style.opacity = "1";
        }, 50);
      });
      // Fade-out animation on navigation
      document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".nav-menu a").forEach((item) => {
          item.addEventListener("click", function (e) {
            const href = this.getAttribute("href");
            if (href && !href.startsWith("#")) {
              e.preventDefault();
              document.body.classList.add("fade-out");
              setTimeout(() => {
                window.location.href = href;
              }, 500);
            }
          });
        });
      });
      // Fade-in animation on page load
      document.addEventListener("DOMContentLoaded", function () {
        setTimeout(() => {
          document.body.style.opacity = "1";
        }, 10);
      });
      // Smooth scrolling for navigation links (hash links only)
      document.querySelectorAll('a[href^="#"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute("href"));
          if (target) {
            target.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          }

          // Close mobile sidebar when clicking a link
          const mobileSidebar = document.querySelector(".mobile-sidebar");
          const mobileOverlay = document.querySelector(".mobile-overlay");
          const hamburger = document.querySelector(".hamburger");

          if (mobileSidebar && mobileOverlay && hamburger) {
            mobileSidebar.classList.remove("active");
            mobileOverlay.classList.remove("active");
            hamburger.classList.remove("active");
          }
        });
      });

      // Handle external links (like /) - just close mobile menu
      document.querySelectorAll('a[href^="/"]').forEach((anchor) => {
        anchor.addEventListener("click", function (e) {
          // Close mobile sidebar when clicking a link
          const mobileSidebar = document.querySelector(".mobile-sidebar");
          const mobileOverlay = document.querySelector(".mobile-overlay");
          const hamburger = document.querySelector(".hamburger");

          if (mobileSidebar && mobileOverlay && hamburger) {
            mobileSidebar.classList.remove("active");
            mobileOverlay.classList.remove("active");
            hamburger.classList.remove("active");
          }
        });
      });

      // Mobile Hamburger Menu
      const hamburger = document.querySelector(".hamburger");
      const mobileSidebar = document.querySelector(".mobile-sidebar");
      const mobileOverlay = document.querySelector(".mobile-overlay");

      if (hamburger && mobileSidebar && mobileOverlay) {
        // Toggle sidebar when hamburger is clicked
        hamburger.addEventListener("click", function () {
          this.classList.toggle("active");
          mobileSidebar.classList.toggle("active");
          mobileOverlay.classList.toggle("active");
          document.body.style.overflow = mobileSidebar.classList.contains(
            "active"
          )
            ? "hidden"
            : "";
        });

        // Close sidebar when overlay is clicked
        mobileOverlay.addEventListener("click", function () {
          hamburger.classList.remove("active");
          mobileSidebar.classList.remove("active");
          this.classList.remove("active");
          document.body.style.overflow = "";
        });

        // Close sidebar when nav links are clicked
        const navLinks = document.querySelectorAll(
          ".mobile-sidebar .nav-menu a"
        );
        navLinks.forEach((link) => {
          link.addEventListener("click", function () {
            hamburger.classList.remove("active");
            mobileSidebar.classList.remove("active");
            mobileOverlay.classList.remove("active");
            document.body.style.overflow = "";
          });
        });

        // Close sidebar when pressing Escape key
        document.addEventListener("keydown", function (e) {
          if (
            e.key === "Escape" &&
            mobileSidebar.classList.contains("active")
          ) {
            hamburger.classList.remove("active");
            mobileSidebar.classList.remove("active");
            mobileOverlay.classList.remove("active");
            document.body.style.overflow = "";
          }
        });
      }

      // Header scroll effect (enhanced shadow on scroll)
      window.addEventListener("scroll", function () {
        const header = document.querySelector(".header");
        const logo = document.querySelector(".logo");
        const navLinks = document.querySelectorAll(".nav-menu a");

        if (window.scrollY > 50) {
          header.classList.add("scrolled");
          header.style.background = "rgba(255, 255, 255, 0.95)";
          header.style.backdropFilter = "blur(20px)";
          header.style.boxShadow = "0 2px 20px rgba(0, 0, 0, 0.1)";
          header.style.borderBottom = "1px solid rgba(255, 255, 255, 0.2)";

          // Change text color to dark when scrolled
          if (logo) {
            logo.style.color = "#333";
            logo.style.textShadow = "none";
          }
          navLinks.forEach((link) => {
            if (link.classList.contains("active")) {
              link.style.color = "#ff6b6b"; // Keep active link red
            } else {
              link.style.color = "#333";
            }
            link.style.textShadow = "none";
          });
        } else {
          header.classList.remove("scrolled");
          header.style.background = "transparent";
          header.style.backdropFilter = "none";
          header.style.boxShadow = "none";
          header.style.borderBottom = "none";

          // Change text color back to dark when at top
          if (logo) {
            logo.style.color = "#333";
            logo.style.textShadow = "none";
          }
          navLinks.forEach((link) => {
            if (link.classList.contains("active")) {
              link.style.color = "#ff6b6b"; // Keep active link red
            } else {
              link.style.color = "#333";
            }
            link.style.textShadow = "none";
          });
        }
      });

      // Set active navigation based on current page
      function setActiveNavigation() {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll(".nav-menu a");
        const mobileNavLinks = document.querySelectorAll(
          ".mobile-sidebar .nav-menu a"
        );

        // Remove active class from all links
        [...navLinks, ...mobileNavLinks].forEach((link) => {
          link.classList.remove("active");
        });

        // Add active class to current page link
        [...navLinks, ...mobileNavLinks].forEach((link) => {
          const linkPath = new URL(link.href).pathname;
          if (
            currentPath === linkPath ||
            (currentPath === "/" && linkPath === "/")
          ) {
            link.classList.add("active");
          }
        });
      }

      // Call function on page load
      setActiveNavigation();

      // Trip Options Functionality
      document.addEventListener("DOMContentLoaded", function () {
        initializeTripOptions();
        initializeMobileTripOptions();
      });

      function initializeMobileTripOptions() {
        const rentCarCard = document.querySelector(".product-card.rent-car");
        if (rentCarCard) {
          const desktopTripOptions = rentCarCard.querySelectorAll(
            ".product-header .trip-options .trip-option"
          );
          const mobileTripOptions = rentCarCard.querySelectorAll(
            ".mobile-trip-options .trip-option"
          );

          // Set initial active state on mobile based on desktop
          desktopTripOptions.forEach((option, index) => {
            if (
              option.classList.contains("active") &&
              mobileTripOptions[index]
            ) {
              mobileTripOptions[index].classList.add("active");
            }
          });

          // Synchronize mobile to desktop
          mobileTripOptions.forEach((option, index) => {
            option.addEventListener("click", function () {
              // Update mobile UI
              mobileTripOptions.forEach((opt) =>
                opt.classList.remove("active")
              );
              this.classList.add("active");

              // Synchronize with desktop options
              if (desktopTripOptions[index]) {
                const event = new MouseEvent("click", {
                  bubbles: true,
                  cancelable: true,
                  view: window,
                });
                desktopTripOptions[index].dispatchEvent(event);
              }
            });
          });

          // Synchronize desktop to mobile
          desktopTripOptions.forEach((option, index) => {
            option.addEventListener("click", function () {
              // Update mobile UI when desktop options are clicked
              mobileTripOptions.forEach((opt) =>
                opt.classList.remove("active")
              );
              if (mobileTripOptions[index]) {
                mobileTripOptions[index].classList.add("active");
              }
            });
          });
        }
      }

      function initializeTripOptions() {
        const productCards = document.querySelectorAll(".product-card");

        productCards.forEach((card) => {
          const tripOptions = card.querySelectorAll(".trip-option");
          const tripOptionsContainer = card.querySelector(".trip-options");
          const priceElement = card.querySelector(".product-price");
          const timeElement = card.querySelector(".trip-time");
          const destinationsElement = card.querySelector(".destinations");

          // Data untuk setiap produk
          const productData = getProductData(card);

          // Set initial state based on active option (or first if none)
          const initialIndex = Array.from(tripOptions).findIndex((opt) =>
            opt.classList.contains("active")
          );
          const startIndex = initialIndex === -1 ? 0 : initialIndex;

          if (productData && productData[startIndex]) {
            if (priceElement)
              priceElement.textContent = productData[startIndex].price;
            if (timeElement)
              timeElement.textContent = productData[startIndex].time;

            // Initialize destinations same as click handler
            if (productData[startIndex].destinations && destinationsElement) {
              destinationsElement.innerHTML = "";
              destinationsElement.style.display = "flex";
              destinationsElement.style.flexDirection = "column";
              destinationsElement.style.alignItems = "flex-start";
              destinationsElement.style.textAlign = "left";
              destinationsElement.style.width = "fit-content";

              productData[startIndex].destinations.forEach((destination) => {
                const li = document.createElement("li");
                li.textContent = destination;
                li.style.fontFamily = '"Noto Sans", sans-serif';
                li.style.color = "#555";
                li.style.fontSize = "0.95rem";
                li.style.padding = "2px 0";
                li.style.position = "relative";
                li.style.paddingLeft = "20px";
                li.style.fontWeight = "400";
                li.style.transition = "all 0.3s ease";
                li.style.display = "block";
                li.style.textAlign = "left";
                li.style.width = "100%";

                const screenWidth = window.innerWidth;
                let iconSize;
                if (screenWidth <= 480) {
                  iconSize = "10px";
                } else if (screenWidth <= 768) {
                  iconSize = "12px";
                } else {
                  iconSize = "14px";
                }

                const icon = document.createElement("span");
                icon.style.position = "absolute";
                icon.style.left = "0";
                icon.style.top = "2px";
                icon.style.width = iconSize;
                icon.style.height = iconSize;
                icon.style.backgroundImage =
                  'url("data:image/svg+xml;base64,")';
                icon.style.backgroundSize = "contain";
                icon.style.backgroundRepeat = "no-repeat";
                icon.style.backgroundPosition = "center";
                icon.style.display = "block";
                icon.style.opacity = "1";
                icon.style.visibility = "visible";
                icon.style.zIndex = "1";

                li.appendChild(icon);
                destinationsElement.appendChild(li);
              });
            }
          }

          tripOptions.forEach((option, index) => {
            option.addEventListener("click", function () {
              // Add clicked effect immediately
              this.classList.add("clicked");

              // Remove clicked effect after animation
              setTimeout(() => {
                this.classList.remove("clicked");
              }, 600);

              // Remove active class from all options in this card
              tripOptions.forEach((opt) => opt.classList.remove("active"));

              // Add active class to clicked option with animation
              this.classList.add("active");

              // Update konten langsung tanpa delay
              if (productData && productData[index]) {
                priceElement.textContent = productData[index].price;
                timeElement.textContent = productData[index].time;

                // Update destinations dengan pastikan FORMAT SAMA PERSIS dengan HTML asli
                if (productData[index].destinations) {
                  destinationsElement.innerHTML = "";
                  // Memastikan parent container memiliki style yang benar
                  destinationsElement.style.display = "flex";
                  destinationsElement.style.flexDirection = "column";
                  destinationsElement.style.alignItems = "flex-start";
                  destinationsElement.style.textAlign = "left";
                  destinationsElement.style.width = "fit-content";

                  productData[index].destinations.forEach((destination) => {
                    const li = document.createElement("li");
                    li.textContent = destination;

                    // COPY EXACT styling dari CSS untuk konsistensi format
                    li.style.fontFamily = '"Noto Sans", sans-serif';
                    li.style.color = "#555";
                    li.style.fontSize = "0.95rem";
                    li.style.padding = "2px 0";
                    li.style.position = "relative";
                    li.style.paddingLeft = "20px";
                    li.style.fontWeight = "400";
                    li.style.transition = "all 0.3s ease";
                    li.style.display = "block"; // Sebelumnya salah nilai 'left'
                    li.style.textAlign = "left"; // Text rata kiri untuk tampilan terstruktur
                    li.style.width = "100%"; // Pastikan lebar penuh

                    // Responsive icon size berdasarkan screen width
                    const screenWidth = window.innerWidth;
                    let iconSize;
                    if (screenWidth <= 480) {
                      iconSize = "10px";
                    } else if (screenWidth <= 768) {
                      iconSize = "12px";
                    } else {
                      iconSize = "14px";
                    }

                    // Buat icon yang SAMA PERSIS dengan CSS :before
                    const icon = document.createElement("span");
                    icon.style.position = "absolute";
                    icon.style.left = "0";
                    icon.style.top = "2px";
                    icon.style.width = iconSize;
                    icon.style.height = iconSize;
                    icon.style.backgroundImage =
                      'url("data:image/svg+xml;base64,")';
                    icon.style.backgroundSize = "contain";
                    icon.style.backgroundRepeat = "no-repeat";
                    icon.style.backgroundPosition = "center";
                    icon.style.display = "block";
                    icon.style.opacity = "1";
                    icon.style.visibility = "visible";
                    icon.style.zIndex = "1";

                    li.appendChild(icon);
                    destinationsElement.appendChild(li);
                  });

                  // Force reflow untuk pastikan styling diterapkan
                  destinationsElement.offsetHeight;
                  console.log(
                    "Destinations updated with IDENTICAL format to HTML"
                  );
                }
              }
            });
          });

          // Inisialisasi: Pastikan button yang sudah active saat page load menampilkan checkmark
          const activeButton = card.querySelector(".trip-option.active");
          if (activeButton) {
            // Force reflow untuk memastikan checkmark CSS diterapkan
            activeButton.offsetHeight;
          }
        });
      }

