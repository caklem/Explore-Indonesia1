---
// ============================================
// PRODUCT PAGE - Indonesia Travel
// ============================================
// CSS: src/styles/product.css
// Status: ✅ Clean (No commented code)
// ============================================
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product | Explore Indonesia</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/LOGO.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/LOGO.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/LOGO.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/LOGO.png?v=2" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Noto+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      @import url("/src/styles/global.css");
      @import url("/src/styles/product.css");
    </style>
  </head>
  <body>
    <Header currentPage="product" />

