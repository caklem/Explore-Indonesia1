                  <div class="product-price">Rp 8.000.000,-</div>
                  <div class="trip-time">06:30 AM - 02:00 PM</div>
                  <ul class="destinations">
                    <li>Kelor Island</li>
                    <li>Manjarite Island</li>
                    <li>Sunset at Kalong Island (Flying Foxes)</li>
                  </ul>
