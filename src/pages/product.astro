                <div class="product-image-container">
                  <div class="image-slider">
                    <img
                      src="/Product_ZS/ZS-1.png"
                      alt="Zikita Speedboat Interior"
                      class="product-image"
                      data-slide="0"
                    />
                    <img
                      src="/Product_ZS/ZS-2.jpg"
                      alt="Zikita Speedboat Exterior"
                      class="product-image"
                      data-slide="1"
                      style="display: none;"
                    />
                    <img
                      src="/Product_ZS/ZS-3.jpg"
                      alt="Zikita Speedboat Deck"
                      class="product-image"
                      data-slide="2"
                      style="display: none;"
                    />
                    <img
                      src="/Product_ZS/ZS-5.jpg"
                      alt="Zikita Speedboat Detail"
                      class="product-image"
                      data-slide="3"
                      style="display: none;"
                    />

                    <button class="slider-nav prev" data-slider="zikita">
                      <svg viewBox="0 0 24 24"
                        ><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                        ></path></svg
                      >
                    </button>
                    <button class="slider-nav next" data-slider="zikita">
                      <svg viewBox="0 0 24 24"
                        ><path
                          d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                        ></path></svg
                      >
                    </button>

                    <div class="slider-dots">
                      <div
                        class="slider-dot active"
                        data-slider="zikita"
                        data-slide="0"
                      >
                      </div>
                      <div
                        class="slider-dot"
                        data-slider="zikita"
                        data-slide="1"
                      >
                      </div>
                      <div
                        class="slider-dot"
                        data-slider="zikita"
                        data-slide="2"
                      >
                      </div>
                      <div
                        class="slider-dot"
                        data-slider="zikita"
                        data-slide="3"
                      >
                      </div>
                    </div>
                  </div>
                </div>
                <div class="product-content">
                  <div class="trip-options">
                    <button class="trip-option active">Half Day Trip</button>
                    <button class="trip-option">Full Day Trip</button>
