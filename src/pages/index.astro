      window.closeDetailModal = function () {
        console.log("Closing modal");
        const modal = document.getElementById("detailModal");
        if (modal) {
          modal.classList.remove("show");
          setTimeout(() => {
            modal.style.display = "none";
          }, 300);
        }
      };

      // Function to update destination colors
      function updateDestinationColors(selectedOption, modal) {
        const tripType = selectedOption.getAttribute("data-trip");
        const halfDayDestinations = modal.querySelectorAll(
          ".half-day-destinations .detail-dest-item"
        );
        const fullDayDestinations = modal.querySelectorAll(
          ".full-day-destinations .detail-dest-item"
        );
        const sunsetDestinations = modal.querySelectorAll(
          ".full-day-sunset .detail-dest-item"
        );

        const setActive = (items) => {
          items.forEach((item) => {
            item.classList.add("active-dest");
            item.classList.remove("inactive-dest");
            const icon = item.querySelector(".detail-dest-icon");
            if (icon) {
              icon.classList.add("active-icon");
              icon.classList.remove("inactive-icon");
            }
          });
        };

        const setInactive = (items) => {
          items.forEach((item) => {
            item.classList.add("inactive-dest");
            item.classList.remove("active-dest");
            const icon = item.querySelector(".detail-dest-icon");
            if (icon) {
              icon.classList.add("inactive-icon");
              icon.classList.remove("active-icon");
            }
          });
        };

        // Reset all to inactive first
        setInactive(halfDayDestinations);
        setInactive(fullDayDestinations);
        setInactive(sunsetDestinations);

        if (tripType === "half-day") {
          setActive(halfDayDestinations);
        } else if (tripType === "full-day") {
          setActive(fullDayDestinations);
        } else if (tripType === "full-day-sunset") {
          setActive(sunsetDestinations);
        }
      }

      // Event Listeners untuk Detail Modal
      document.addEventListener("DOMContentLoaded", function () {
        console.log(
          "DOM loaded, setting up button listeners - UPDATED VERSION"
        );

        // Setup view details buttons dengan cara yang lebih langsung
        const buttons = document.querySelectorAll(
          ".view-details-btn[data-package]"
        );
        console.log("Found buttons:", buttons.length);

        // Setup setiap button satu per satu
        buttons.forEach(function (btn, index) {
          console.log("Setting up button", index, btn);

          // Hapus semua event listener yang ada
          const newBtn = btn.cloneNode(true);
          btn.parentNode.replaceChild(newBtn, btn);

          // Tambah event listener baru
          newBtn.onclick = function (e) {
            e.preventDefault();
            e.stopPropagation();
            console.log("Button clicked!", this);

            const packageType = this.getAttribute("data-package");
            console.log("Package type:", packageType);

            // Panggil function secara langsung
            openModal(packageType);
          };
        });

        const modal = document.getElementById("detailModal");
        const closeBtn = document.querySelector(".detail-modal-close");

        // Close modal dengan tombol X
        if (closeBtn) {
          closeBtn.addEventListener("click", window.closeDetailModal);
        }

        // Close modal dengan klik background
        if (modal) {
          modal.addEventListener("click", function (event) {
            if (event.target === modal) {
              window.closeDetailModal();
            }
          });
        }

        // Close modal dengan ESC key
        document.addEventListener("keydown", function (event) {
          if (event.key === "Escape") {
            window.closeDetailModal();
          }
        });
      });
    </script>

