        if (modalType === "zikita") {
          modalZikita.classList.remove("show");
        } else if (modalType === "zaviero") {
          modalZaviero.classList.remove("show");
        } else if (modalType === "rentcar") {
          modalRentCar.classList.remove("show");
        }
      }

