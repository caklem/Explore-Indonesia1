          modal = modalZaviero;
        } else if (modalType === "rentcar") {
          modal = modalRentCar;
        }
        if (modal) {
          modal.classList.add("show");
          // Initialize destination colors
          const activeOpt = modal.querySelector(".detail-trip-option.active");
          if (activeOpt) updateDestinationColors(activeOpt, modal);
        }
      }

      // Function to close specific modal
