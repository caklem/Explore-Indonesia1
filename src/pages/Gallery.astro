---
// Halaman Gallery - Top Pick Destinations
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gallery | Explore Indonesia</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/LOGO.png?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="/LOGO.png?v=2" />
    <link rel="shortcut icon" type="image/png" href="/LOGO.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/LOGO.png?v=2" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&family=Noto+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: "Cormorant Garamond", serif;
        line-height: 1.6;
        color: #333;
        background-color: #f4f4f4;
        opacity: 0;
        transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        text-transform: uppercase;
        font-weight: bold;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      body.fade-out {
        opacity: 0;
        transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      }
      /* Header Styles */
      .header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 1000;
        padding: 20px 0;
        background: transparent;
        transition: all 0.3s ease;
        font-family: "Noto Sans", sans-serif;
      }

      .header.scrolled {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1);
      }

      .header.scrolled .logo {
        color: #333;
        text-shadow: none;
      }

      .header.scrolled .nav-menu a {
        color: #333;
        text-shadow: none;
      }

      .header.scrolled .nav-menu a.active {
        color: #ff6b6b;
      }

      .header.scrolled .nav-menu a:hover {
        color: #ff6b6b;
      }

      .nav-container {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 40px;
      }

      .logo {
        color: #333;
        font-family: "Cormorant Garamond", serif;
        font-size: 1.8rem;
        font-weight: 700;
        text-decoration: none;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .logo-highlight {
        color: #ff6b6b;
      }

      .nav-menu {
        display: flex;
        list-style: none;
        gap: 40px;
        font-family: "Noto Sans", sans-serif;
      }

      .nav-menu a {
        color: #333;
        text-decoration: none;
        font-weight: 700;
        font-size: 14px;
        text-transform: none;
        letter-spacing: 0.5px;
        position: relative;
        transition: all 0.3s ease;
      }

      .nav-menu a:hover {
        color: #ff6b6b;
      }

      .nav-menu a.active {
        color: #ff6b6b;
      }

      /* Mobile Hamburger Menu */
      .hamburger {
        display: none;
        flex-direction: column;
        cursor: pointer;
        gap: 4px;
      }

      .hamburger span {
        width: 25px;
        height: 3px;
        background-color: #333;
        transition: all 0.3s ease;
        border-radius: 2px;
      }

      /* Hamburger color when scrolled */
      .header.scrolled .hamburger span {
        background-color: #333;
      }

      .hamburger.active span:nth-child(1) {
        transform: rotate(45deg) translate(5px, 5px);
      }

      .hamburger.active span:nth-child(2) {
        opacity: 0;
      }

      .hamburger.active span:nth-child(3) {
        transform: rotate(-45deg) translate(7px, -6px);
      }

      /* Mobile Sidebar */
      .mobile-sidebar {
        position: fixed;
        top: 0;
        right: -300px;
        width: 300px;
        height: 100vh;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        z-index: 9999;
        transition: right 0.3s ease;
        padding: 80px 30px 30px;
        box-shadow: -5px 0 20px rgba(0, 0, 0, 0.1);
      }

      .mobile-sidebar.active {
        right: 0;
      }

      .mobile-sidebar .nav-menu {
        flex-direction: column;
        gap: 20px;
        display: flex;
      }

      .mobile-sidebar .nav-menu a {
        color: #2c3e50;
        font-size: 16px;
        font-weight: 700;
        padding: 15px 0;
        border-bottom: 1px solid rgba(0, 0, 0, 0.08);
        text-shadow: none;
        text-transform: none;
        text-decoration: none;
        transition: all 0.3s ease;
      }

      .mobile-sidebar .nav-menu a:hover {
        color: #ff6b6b;
        transform: translateX(5px);
      }

      /* Overlay */
      .mobile-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
        z-index: 9998;
        opacity: 0;
        visibility: hidden;
        transition: all 0.3s ease;
      }

      .mobile-overlay.active {
        opacity: 1;
        visibility: visible;
      }

      /* ...existing code for hamburger, sidebar, overlay, etc. from index.astro... */
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 60px 40px;
        margin-top: 120px;
        margin-bottom: 60px;
      }
      .title {
        font-size: 42px;
        font-weight: bold;
        color: #333;
        margin-bottom: 50px;
        text-align: left;
      }
      .destinations-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 25px;
        margin-top: 40px;
      }
      .destination-card {
        position: relative;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
        transition:
          transform 0.3s ease,
          box-shadow 0.3s ease;
        background: white;
      }
      .destination-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
      }
      .destination-card img {
        width: 100%;
        height: 280px;
        object-fit: cover;
        display: block;
      }
      .card-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
        padding: 30px 20px 20px;
        color: white;
      }
      .destination-name {
        font-size: 18px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
      }

      /* Gallery Modal Styles */
      .gallery-modal {
        display: none;
        position: fixed;
        z-index: 10000;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.9);
        backdrop-filter: blur(5px);
      }

      .gallery-modal.show {
        display: block;
      }

      .gallery-modal-content {
        position: relative;
        margin: auto;
        padding: 0;
        width: 90%;
        max-width: 1000px;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .gallery-image-container {
        position: relative;
        display: inline-block;
      }

      .gallery-modal img {
        max-width: 100%;
        max-height: 90vh;
        object-fit: contain;
        border-radius: 10px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      }

      .gallery-close {
        position: absolute;
        top: 10px;
        right: 10px;
        color: #fff;
        font-size: 36px;
        font-weight: bold;
        cursor: pointer;
        z-index: 10001;
        transition: all 0.3s ease;
        background: rgba(0, 0, 0, 0.8);
        border: 2px solid rgba(255, 255, 255, 0.2);
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
      }

      .gallery-close:hover {
        background: rgba(255, 107, 107, 0.9);
        border-color: rgba(255, 255, 255, 0.4);
        transform: scale(1.1);
        box-shadow: 0 6px 20px rgba(255, 107, 107, 0.4);
      }

      .gallery-prev,
      .gallery-next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: #fff;
        font-size: 30px;
        font-weight: bold;
        cursor: pointer;
        padding: 15px;
        background: rgba(0, 0, 0, 0.5);
        border-radius: 50%;
        transition: all 0.3s ease;
        user-select: none;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10002;
      }

      .gallery-prev {
        left: 30px;
      }

      .gallery-next {
        right: 30px;
      }

      .gallery-prev:hover,
      .gallery-next:hover {
        background: rgba(255, 107, 107, 0.8);
        transform: translateY(-50%) scale(1.1);
      }

      .gallery-info {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        color: #fff;
        text-align: center;
        background: rgba(0, 0, 0, 0.8);
        padding: 10px 20px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
      }

      .gallery-title {
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 5px;
        font-family: "Cormorant Garamond", serif;
      }

      .gallery-counter {
        font-size: 14px;
        opacity: 0.8;
        font-family: "Noto Sans", sans-serif;
      }

      /* Clickable cursor for cards */
      .destination-card {
        cursor: pointer;
      }

      .destination-card:hover {
        transform: translateY(-8px) scale(1.02);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
      }
      @media (max-width: 768px) {
        .nav-menu {
          display: none;
        }

        .hamburger {
          display: flex;
        }

        /* Ensure header consistency on mobile */
        .header {
          position: fixed;
          top: 0;
          left: 0;
          right: 0;
          z-index: 1000;
          padding: 15px 0;
          transition: all 0.3s ease;
        }

        .header.scrolled {
          background: rgba(255, 255, 255, 0.95) !important;
          backdrop-filter: blur(20px) !important;
          box-shadow: 0 2px 20px rgba(0, 0, 0, 0.1) !important;
        }

        .nav-container {
          max-width: 100%;
          padding: 0 20px;
        }

        .logo {
          font-size: 1.4rem;
        }

        .container {
          padding: 30px 15px;
          margin-top: 100px !important;
        }

        .destinations-grid {
          grid-template-columns: 1fr;
          gap: 15px;
          padding: 0 5px;
        }

        .destination-card img {
          height: 280px;
        }

        .title {
          font-size: 28px;
          text-align: center;
          margin-bottom: 25px;
          padding: 0 10px;
        }

        /* Gallery Modal Mobile Adjustments */
        .gallery-modal-content {
          width: 100%;
          padding: 0;
        }

        .gallery-modal img {
          max-height: 70vh;
          max-width: 95%;
          border-radius: 8px;
        }

        .gallery-prev,
        .gallery-next {
          width: 45px;
          height: 45px;
          font-size: 20px;
          padding: 8px;
        }

        .gallery-prev {
          left: 10px;
        }

        .gallery-next {
          right: 10px;
        }

        .gallery-close {
          top: 15px;
          right: 15px;
          font-size: 32px;
          width: 45px;
          height: 45px;
        }

        .gallery-info {
          bottom: 15px;
          padding: 10px 20px;
          max-width: 90%;
        }

        .gallery-title {
          font-size: 18px;
          margin-bottom: 5px;
        }

        .gallery-counter {
          font-size: 13px;
        }
      }
      @media (max-width: 1024px) and (min-width: 769px) {
        .destinations-grid {
          grid-template-columns: repeat(2, 1fr);
          gap: 25px;
        }

        .destination-card img {
          height: 280px;
        }

        /* Ensure header consistency on tablet */
        .header {
          padding: 12px 0;
        }

        .nav-container {
          padding: 0 25px;
        }

        .container {
          padding: 40px 25px;
          margin-top: 110px !important;
        }

        .title {
          font-size: 36px;
          margin-bottom: 30px;
        }

        .gallery-modal img {
          max-height: 85vh;
        }

        .gallery-prev,
        .gallery-next {
          width: 55px;
          height: 55px;
          font-size: 26px;
        }

        .gallery-prev {
          left: 20px;
        }

        .gallery-next {
          right: 20px;
        }
      }

      @media (max-width: 480px) {
        .nav-container {
          padding: 0 15px;
        }

        .logo {
          font-size: 1.3rem;
        }

        .title {
          font-size: 24px;
          margin-bottom: 20px;
        }

        .container {
          padding: 25px 10px;
          margin-top: 95px !important;
        }

        .destinations-grid {
          gap: 12px;
        }

        .destination-card img {
          height: 280px;
        }

        /* Gallery Modal Extra Small Mobile Styles */
        .gallery-modal-content {
          width: 100%;
          padding: 0;
        }

        .gallery-image-container {
          position: relative;
          width: 100%;
        }

        .gallery-modal img {
          max-height: 65vh;
          max-width: 90%;
          border-radius: 6px;
        }

        .gallery-close {
          position: absolute;
          top: 10px;
          right: 10px;
          font-size: 28px;
          width: 40px;
          height: 40px;
          background: rgba(0, 0, 0, 0.9);
          border: 2px solid rgba(255, 255, 255, 0.3);
          color: white;
          z-index: 10002;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          box-shadow: 0 4px 15px rgba(0, 0, 0, 0.4);
          transition: all 0.3s ease;
        }

        .gallery-close:hover {
          background: rgba(255, 107, 107, 0.9);
          border-color: rgba(255, 255, 255, 0.5);
          transform: scale(1.05);
        }

        .gallery-prev,
        .gallery-next {
          width: 40px;
          height: 40px;
          font-size: 18px;
          padding: 6px;
        }

        .gallery-prev {
          left: 8px;
        }

        .gallery-next {
          right: 8px;
        }

        .gallery-info {
          bottom: 12px;
          padding: 8px 15px;
          max-width: 80%;
          border-radius: 12px;
        }

        .gallery-title {
          font-size: 16px;
          margin-bottom: 3px;
        }

        .gallery-counter {
          font-size: 11px;
        }
      }

      /* Extra Large Screens */
      @media (min-width: 1440px) {
        .container {
          max-width: 1400px;
          margin-left: auto;
          margin-right: auto;
        }

        .destinations-grid {
          grid-template-columns: repeat(3, 1fr);
          gap: 35px;
        }

        .destination-card img {
          height: 280px;
        }

        .title {
          font-size: 48px;
        }
      }

      /* Small Desktop / Large Tablet */
      @media (min-width: 1025px) and (max-width: 1439px) {
        .destinations-grid {
          grid-template-columns: repeat(3, 1fr);
          gap: 30px;
        }

        .destination-card img {
          height: 280px;
        }

        .container {
          padding: 50px 30px;
        }
      }
    </style>
  </head>
  <body>
    <Header currentPage="gallery" />

    <div class="container" style="margin-top:100px;">
      <h1 class="title">Top Pick Destinations</h1>
      <div class="destinations-grid">
        <!-- Gallery images from hero images folder -->
        <div class="destination-card">
          <img src="/hero images/HI-1.jpeg" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/hero images/HI-3.jpeg" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/hero images/HI-4.jpeg" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/hero images/HI-6.jpeg" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/hero images/HI-7.png" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/hero images/HI-8.png" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/hero images/HI-9.png" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/Product_ZV/ZV-10.jpg" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
        <div class="destination-card">
          <img src="/ABOUT.JPG" alt="Explore Indonesia" />
          <div class="card-overlay">
            <div class="destination-name"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Gallery Modal -->
    <div id="galleryModal" class="gallery-modal">
      <div class="gallery-modal-content">
        <span class="gallery-prev">&#10094;</span>
        <span class="gallery-next">&#10095;</span>
        <div class="gallery-image-container">
          <span class="gallery-close">&times;</span>
          <img id="galleryModalImg" src="" alt="" />
          <div class="gallery-info">
            <div class="gallery-title" id="galleryTitle"></div>
            <div class="gallery-counter" id="galleryCounter"></div>
          </div>
        </div>
      </div>
    </div>
  </body>
  <script>
    // Mobile Hamburger Menu & Header Scroll Effect
    const hamburger = document.querySelector(".hamburger");
    const mobileSidebar = document.querySelector(".mobile-sidebar");
    const mobileOverlay = document.querySelector(".mobile-overlay");
    const navLinks = document.querySelectorAll(".mobile-sidebar .nav-menu a");

    if (hamburger && mobileSidebar && mobileOverlay) {
      hamburger.addEventListener("click", function () {
        this.classList.toggle("active");
        mobileSidebar.classList.toggle("active");
        mobileOverlay.classList.toggle("active");
        document.body.style.overflow = mobileSidebar.classList.contains(
          "active"
        )
          ? "hidden"
          : "";
      });

      mobileOverlay.addEventListener("click", function () {
        hamburger.classList.remove("active");
        mobileSidebar.classList.remove("active");
        this.classList.remove("active");
        document.body.style.overflow = "";
      });

      navLinks.forEach((link) => {
        link.addEventListener("click", function () {
          hamburger.classList.remove("active");
          mobileSidebar.classList.remove("active");
          mobileOverlay.classList.remove("active");
          document.body.style.overflow = "";
        });
      });

      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && mobileSidebar.classList.contains("active")) {
          hamburger.classList.remove("active");
          mobileSidebar.classList.remove("active");
          mobileOverlay.classList.remove("active");
          document.body.style.overflow = "";
        }
      });
    }
    window.addEventListener("scroll", function () {
      const header = document.querySelector(".header");
      const logo = document.querySelector(".logo");
      const navLinks = document.querySelectorAll(".nav-menu a");

      if (window.scrollY > 50) {
        header.classList.add("scrolled");
        header.style.background = "rgba(255, 255, 255, 0.95)";
        header.style.backdropFilter = "blur(20px)";
        header.style.boxShadow = "0 2px 20px rgba(0, 0, 0, 0.1)";
        header.style.borderBottom = "1px solid rgba(255, 255, 255, 0.2)";

        // Change text color to dark when scrolled
        logo.style.color = "#333";
        logo.style.textShadow = "none";
        navLinks.forEach((link) => {
          if (link.classList.contains("active")) {
            link.style.color = "#ff6b6b"; // Keep active link red
          } else {
            link.style.color = "#333";
          }
          link.style.textShadow = "none";
        });
      } else {
        header.classList.remove("scrolled");
        header.style.background = "transparent";
        header.style.backdropFilter = "none";
        header.style.boxShadow = "none";
        header.style.borderBottom = "none";

        // Change text color back to dark when at top
        logo.style.color = "#333";
        logo.style.textShadow = "none";
        navLinks.forEach((link) => {
          if (link.classList.contains("active")) {
            link.style.color = "#ff6b6b"; // Keep active link red
          } else {
            link.style.color = "#333";
          }
          link.style.textShadow = "none";
        });
      }
    });

    // Set active navigation based on current page
    function setActiveNavigation() {
      const currentPath = window.location.pathname;
      const navLinks = document.querySelectorAll(".nav-menu a");
      const mobileNavLinks = document.querySelectorAll(
        ".mobile-sidebar .nav-menu a"
      );

      // Remove active class from all links
      [...navLinks, ...mobileNavLinks].forEach((link) => {
        link.classList.remove("active");
      });

      // Add active class to current page link
      [...navLinks, ...mobileNavLinks].forEach((link) => {
        const linkPath = new URL(link.href).pathname;
        if (
          currentPath === linkPath ||
          (currentPath === "/" && linkPath === "/")
        ) {
          link.classList.add("active");
        }
      });
    }

    // Call function on page load
    setActiveNavigation();
    // Add smooth scrolling and interactive effects
    document.addEventListener("DOMContentLoaded", function () {
      // Navigation menu interaction
      const navItems = document.querySelectorAll(".nav-menu a");
      // Fade-in animation on page load
      setTimeout(() => {
        document.body.style.opacity = "1";
      }, 50);
      navItems.forEach((item) => {
        item.addEventListener("click", function (e) {
          navItems.forEach((nav) => nav.classList.remove("active"));
          this.classList.add("active");
          // Fade out animation before navigation
          const href = this.getAttribute("href");
          if (href && !href.startsWith("#")) {
            e.preventDefault();
            document.body.classList.add("fade-out");
            setTimeout(() => {
              window.location.href = href;
            }, 500);
          }
        });
      });
      // Add loading animation for destination cards
      const cards = document.querySelectorAll(".destination-card");
      const observerOptions = {
        threshold: 0.1,
        rootMargin: "0px 0px -50px 0px",
      };
      const observer = new IntersectionObserver(function (entries) {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.style.opacity = "1";
            entry.target.style.transform = "translateY(0)";
          }
        });
      }, observerOptions);
      cards.forEach((card, index) => {
        card.style.opacity = "0";
        card.style.transform = "translateY(30px)";
        card.style.transition = `opacity 0.6s ease ${index * 0.1}s, transform 0.6s ease ${index * 0.1}s`;
        observer.observe(card);
      });

      // Gallery Modal Functionality
      const galleryModal = document.getElementById("galleryModal");
      const galleryModalImg = document.getElementById("galleryModalImg");
      const galleryTitle = document.getElementById("galleryTitle");
      const galleryCounter = document.getElementById("galleryCounter");
      const galleryClose = document.querySelector(".gallery-close");
      const galleryPrev = document.querySelector(".gallery-prev");
      const galleryNext = document.querySelector(".gallery-next");

      const destinations = [
        {
          name: "",
          image: "/hero images/HI-1.jpeg",
          description: "",
        },
        {
          name: "",
          image: "/hero images/HI-3.jpeg",
          description: "",
        },
        {
          name: "",
          image: "/hero images/HI-4.jpeg",
          description: "",
        },
        {
          name: "",
          image: "/hero images/HI-6.jpeg",
          description: "",
        },
        {
          name: "",
          image: "/hero images/HI-7.png",
          description: "",
        },
        {
          name: "",
          image: "/hero images/HI-8.png",
          description: "",
        },
        {
          name: "",
          image: "/hero images/HI-9.png",
          description: "",
        },
        {
          name: "",
          image: "/Product_ZV/ZV-10.jpg",
          description: "",
        },
        {
          name: "",
          image: "/ABOUT.JPG",
          description: "",
        },
      ];

      let currentImageIndex = 0;

      // Add click event listeners to destination cards
      const destinationCards = document.querySelectorAll(".destination-card");
      destinationCards.forEach((card, index) => {
        card.addEventListener("click", () => {
          openGalleryModal(index);
        });
      });

      function openGalleryModal(index) {
        currentImageIndex = index;
        showImage(currentImageIndex);
        galleryModal.classList.add("show");
        document.body.style.overflow = "hidden";
      }

      function showImage(index) {
        const destination = destinations[index];
        galleryModalImg.src = destination.image;
        galleryModalImg.alt = destination.description;
        galleryTitle.textContent = destination.name;
        galleryCounter.textContent = `${index + 1} / ${destinations.length}`;
      }

      function closeGalleryModal() {
        galleryModal.classList.remove("show");
        document.body.style.overflow = "";
      }

      function nextImage() {
        currentImageIndex = (currentImageIndex + 1) % destinations.length;
        showImage(currentImageIndex);
      }

      function prevImage() {
        currentImageIndex =
          (currentImageIndex - 1 + destinations.length) % destinations.length;
        showImage(currentImageIndex);
      }

      // Event listeners for modal controls
      if (galleryClose) {
        galleryClose.addEventListener("click", closeGalleryModal);
      }

      if (galleryNext) {
        galleryNext.addEventListener("click", nextImage);
      }

      if (galleryPrev) {
        galleryPrev.addEventListener("click", prevImage);
      }

      // Close modal when clicking outside the image
      if (galleryModal) {
        galleryModal.addEventListener("click", (e) => {
          if (e.target === galleryModal) {
            closeGalleryModal();
          }
        });
      }

      // Keyboard navigation
      document.addEventListener("keydown", (e) => {
        if (galleryModal.classList.contains("show")) {
          switch (e.key) {
            case "Escape":
              closeGalleryModal();
              break;
            case "ArrowLeft":
              prevImage();
              break;
            case "ArrowRight":
              nextImage();
              break;
          }
        }
      });
    });
  </script>

  <!-- Footer -->
  <Footer />
</html>
